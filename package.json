{
  "name": "iobroker.smart-text2command",
  "version": "0.0.5",
  "description": "smart-text2command",
  "author": {
    "name": "oweitman",
    "email": "oweitman@gmx.de"
  },
  "contributors": [],
  "homepage": "https://github.com/oweitman/ioBroker.smart-text2command",
  "license": "MIT",
  "keywords": [
    "template",
    "automation",
    "IoT",
    "integration"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/oweitman/ioBroker.smart-text2command.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "@nlpjs/lang-de": "^4.26.1",
    "@nlpjs/lang-en": "^4.26.1",
    "@nlpjs/nlp": "^4.27.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.2",
    "@tsconfig/node22": "^22.0.6",
    "@types/iobroker": "npm:@iobroker/types@^7.2.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "main": "src/main.ts",
  "files": [
    "admin/",
    "src/",
    "documentation/",
    "resources/",
    "www/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "check:admin": "npm run check --prefix src-admin",
    "build": "npm run check && npm run build:admin",
    "build:admin": "npm run build --prefix src-admin",
    "lint": "eslint -c eslint.config.mjs src test/*.test.ts",
    "format:check": "prettier --check src test/*.test.ts eslint.config.mjs prettier.config.mjs",
    "format:check:admin": "prettier --check src-admin/src src-admin/vite.config.ts src-admin/index_m.html src-admin/scripts",
    "format": "prettier --write src test/*.test.ts eslint.config.mjs prettier.config.mjs",
    "format:admin": "prettier --write src-admin/src src-admin/vite.config.ts src-admin/index_m.html src-admin/scripts",
    "test:ts": "mocha --config test/mocharc.custom.json test/**/*.test.ts",
    "test:js": "mocha --config test/mocharc.custom.json test/**/*.test.ts",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "translate": "translate-adapter",
    "dev:upload": "dev-server upload",
    "dev:run": "dev-server run",
    "dev:watch": "dev-server watch --noStart",
    "watch:react": "npm run watch --prefix src-admin",
    "repochecker": "npx @iobroker/repochecker https://github.com/oweitman/ioBroker.smart-text2command --local --env=../iobroker.env",
    "release": "release-script --all"
  },
  "bugs": {
    "url": "https://github.com/oweitman/ioBroker.smart-text2command/issues"
  },
  "readmeFilename": "README.md"
}
