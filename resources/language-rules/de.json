  "setpointTarget": "\\b(?:soll\\s*temperatur|sollwert)\\b",
  "buttonPressVerb": "\\b(?:drücke|drück|betätige|betätig|auslösen|löse\\s+aus)\\b",
  "buttonActivationVerb": "\\b(?:aktiviere|aktivier)\\b",
  "buttonSwitchVerb": "\\b(?:schalte|schalt)\\b",
