  "numericPercent": "%|prozent",
  "numericTemperature": "°\\s*c|grad|celsius",
  "quoted": "[\"„“]([^\"„“]{2,100})[\"„“]",
  "valueDomainTemperature": "\\b(warm|warme|warmer|temperatur|grad|kalt|heiss)\\b",
  "valueDomainBrightness": "\\b(hell|helligkeit|dimmwert)\\b",
  "valueDomainPosition": "\\b(rollladen|rolladen|jalousie|position|behang)\\b",
  "valueDomainTilt": "\\b(lamelle|lamellen|lamellenstellung|tilt)\\b",
